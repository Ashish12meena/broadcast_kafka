# =====================================================================================
# broadcast-service — environment variables (generated from application*.yml; keep in sync)
#
#   cp .env.example .env        then uncomment ONLY what you need to change.
#
# Precedence, highest first: real environment variables > ./.env > ../platform.env >
# the defaults in application*.yml (shown below). A commented line keeps its default.
# NEVER write an empty value (VAR=): an empty value REPLACES the default with "".
# No inline comments: in this format '#' starts a comment only at the start of a line.
# .env is git-ignored; never commit real values. See docs/configuration in the platform docs.
# =====================================================================================

# ---- Profile -------------------------------------------------------------------------------
# Path of the shared platform.env (default ../platform.env, relative to the working directory).
# APARGO_PLATFORM_ENV=../platform.env
# Spring profile: dev on a developer machine / dev server, prod in production.
# SPRING_PROFILES_ACTIVE=test

# ---- Shared infrastructure — normally set ONCE in ../platform.env; set here only to override for this service ---
# Kafka brokers, host:port[,host:port].
#   (dev profile default: localhost:9092)
#   (prod profile: required, no default)
# KAFKA_BOOTSTRAP_SERVERS=146.88.24.113:9092
# Redis host.
#   (dev profile default: localhost)
#   (prod profile: required, no default)
# REDIS_HOST=146.88.24.113
# Redis port.
# REDIS_PORT=6379
# BROADCAST_SERVICE_PORT=8060
# Meta Graph API base URL.
# META_GRAPH_BASE_URL=https://graph.facebook.com
# Meta Graph API version, e.g. v23.0.
# META_GRAPH_API_VERSION=v23.0
# Eureka server URL.
#   (dev profile default: http://localhost:8761/eureka)
# EUREKA_DEFAULT_ZONE=http://146.88.24.113:8761/eureka
# BROADCAST_MANAGEMENT_PORT=9090
# WEBHOOK_SERVICE_URL=http://146.88.24.113:8090

# ---- Other secrets (this service only) -----------------------------------------------------
# Redis password.
#   (prod profile: required, no default)
# REDIS_PASSWORD=<secret>

# ---- Service settings ----------------------------------------------------------------------
# KAFKA_CONSUMER_GROUP=broadcast-service
# KAFKA_MAX_PARTITION_FETCH_BYTES=12582912
# KAFKA_FETCH_MAX_BYTES=37748736
# SHUTDOWN_TIMEOUT=45s
# HTTP port for this service only; normally the port comes from <NAME>_SERVICE_PORT in ../platform.env.
# SERVER_PORT=8060
# TOPIC_OUTBOUND=whatsapp.messages.outbound
# TOPIC_CAPACITY=whatsapp.capacity.updates
# TOPIC_MESSAGE_RESULTS=whatsapp.messages.results
# TOPIC_DLQ=whatsapp.messages.outbound.dlq
# KAFKA_DISPATCH_CONCURRENCY=6
# ASSUMED_INSTANCES=3
# Register with Eureka.
#   (dev profile default: false)
#   (test profile default: false)
# EUREKA_ENABLED=true
# Register with the IP address instead of the hostname.
# EUREKA_PREFER_IP_ADDRESS=true
# MANAGEMENT_SERVER_PORT=9090
# Actuator endpoints exposed over HTTP, comma-separated.
# MANAGEMENT_ENDPOINTS=health,info,prometheus,metrics,loggers
# Health details: never | when-authorized | always.
# MANAGEMENT_HEALTH_DETAILS=always
# Log level of this service's own packages.
#   (dev profile default: DEBUG)
#   (prod profile default: INFO)
# LOG_LEVEL_APP=OFF
# LOG_LEVEL_KAFKA=OFF
# MAX_CONCURRENT_SENDS=64
# META_MAX_CONNECTIONS=64
# SIM_CALLBACK_URL=http://146.88.24.113:8090/api/v1/webhook
# SIM_CALLBACK_MIN_DELAY=200ms
# SIM_CALLBACK_MAX_DELAY=2s
# SIM_CALLBACK_MAX_IN_FLIGHT=128
# SIM_CALLBACK_MAX_CONNECTIONS=128

# ---- Older names — still honoured as fallbacks, use the new name instead -------------------
# KAFKA_GROUP_ID  ->  use KAFKA_CONSUMER_GROUP
# META_BASE_URL  ->  use META_GRAPH_BASE_URL + META_GRAPH_API_VERSION
# EUREKA_SERVER_URL  ->  use EUREKA_DEFAULT_ZONE
